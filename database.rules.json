{
  "rules": {
    "games": {
      "$game": {
        "$roomId": {
          ".read": "auth!=null",
          ".write": "auth!=null&&(!data.exists()||root.child('games').child($game).child($roomId).child('owners').child(auth.uid).exists())",
          "players": {
            "$playerId": {
              ".read": "auth!=null",
              ".write": "auth!=null&&((!data.exists()&&newData.child('ownerUid').val()==auth.uid)||(data.exists()&&data.child('ownerUid').val()==auth.uid))"
            }
          },
          "owners": {
            "$uid": {
              ".read": "auth!=null",
              ".write": "auth!=null&&$uid==auth.uid"
            }
          },
          ".validate": "true"
        }
      }
    }
  }
}
