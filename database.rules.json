{
  "rules": {
    "games": {
      "$game": {
        ".read": "auth!=null",
        ".write": "auth!=null",
        "$roomId": {
          ".read": "auth!=null",
          ".write": "auth!=null&&(!data.exists()||root.child('games').child($game).child($roomId).child('owners').child(auth.uid).exists())",
          "players": {
            ".read": "auth!=null",
            ".write": "auth!=null"
          },
          "owners": {
            "$ownerId": {
              ".read": "auth!=null",
              ".write": "auth!=null&&$ownerId==auth.uid"
            }
          },
          ".validate": "true"
        }
      }
    }
  }
}
